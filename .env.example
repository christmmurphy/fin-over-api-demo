# Fin Agent API key — Settings > Fin Agent API > Generate API key, in your workspace.
FIN_AGENT_API_KEY=

# Your workspace's app id (shown in the Intercom URL, e.g. app.intercom.com/a/apps/<this>/).
INTERCOM_APP_ID=your-workspace-id

# Optional fallback read token — only needed if your Fin Agent API key's scopes
# don't allow GET /conversations/{id} for polling. A personal access token with
# conversation read access works.
FALLBACK_READ_TOKEN=

PORT=4790
